+void AudioService::CheckSpeakerActiveState() {
+    if (!is_speaker_active_.load()) {
+        return;
+    }
+    auto now = std::chrono::steady_clock::now();
+    auto output_elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_output_time_).count();
+    if (output_elapsed > SPEAKER_ACTIVE_TIMEOUT_MS) {
+        SetSpeakerActive(false);
+    }
+}
+
+void AudioService::SetSpeakerActive(bool active) {
+    bool prev = is_speaker_active_.exchange(active);
+    if (prev != active && on_speaker_active_change_) {
+        on_speaker_active_change_(active);
+    }
+}
+
